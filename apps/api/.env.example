DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reraos?schema=public"

# Comma-separated list of origins allowed to call this API from a browser.
# Must include every frontend origin that fetches this API directly.
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://rerastreat.netlify.app"

# Required in production — signs/verifies auth JWTs. Falls back to an
# insecure default ("supersecret") if unset, so always set this explicitly
# outside local dev.
JWT_SECRET="change-me-to-a-long-random-string"

# Railway sets PORT automatically; only needed for local overrides.
# PORT=3001

# --- Optional: staff notifications (safe to leave unset; logs a warning instead) ---
# STAFF_NOTIFICATION_WHATSAPP_NUMBER="09124800610"
# STAFF_NOTIFICATION_EMAIL="rerastreat@gmail.com"

# --- Optional: outgoing email via SMTP (skipped with a warning if unset) ---
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# --- Optional: WhatsApp notifications via Sendchamp (skipped with a warning if unset) ---
# SENDCHAMP_API_KEY=""
# SENDCHAMP_TEMPLATE_CODE=""
# SENDCHAMP_SENDER=""

# --- Optional: payment account shown to customers (defaults to placeholder values) ---
# PAYMENT_BANK_NAME="First Bank"
# PAYMENT_ACCOUNT_NAME="ReraOS Restaurant"
# PAYMENT_ACCOUNT_NUMBER="0123456789"
