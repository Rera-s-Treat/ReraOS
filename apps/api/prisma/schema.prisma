generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  PASSWORD_RESET
  ORDER_STATUS_CHANGED
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderChannel {
  WHATSAPP
  MANUAL
  WALK_IN
  WEBSITE
}

enum OrderType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum PaymentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
  REFUNDED
}

enum KitchenStatus {
  NOT_STARTED
  KITCHEN_INFORMED
  PREPARING
  READY
}

enum FulfillmentStatus {
  PENDING
  PICKED_UP
  SERVED
  DELIVERED
  CANCELLED
}

enum CommunityTown {
  OGIJO
  ITAOLUWO
  SHIMAWA
  ODONGUYAN
  LUKOSI
}

enum CommunityMenuInterest {
  SMALL_CHOPS
  FINGER_FOODS
  PASTA
  DRINKS
}

model CommunityMember {
  id               String                 @id @default(uuid())

  name             String
  phone            String?
  email            String?

  town             CommunityTown
  menuInterest     CommunityMenuInterest?

  welcomeSentAt    DateTime?
  welcomeSendError String?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([town])
  @@index([createdAt])
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String

  firstName           String
  lastName            String
  phone               String?

  status              UserStatus        @default(ACTIVE)

  emailVerified       Boolean           @default(false)

  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?

  lastLoginAt         DateTime?

  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  roleId              String
  role                Role              @relation(fields: [roleId], references: [id])

  refreshTokens       RefreshToken[]
  passwordHistory     PasswordHistory[]
  auditLogs           AuditLog[]
  createdOrders       Order[]           @relation("OrderCreatedBy")

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
}

model Role {
  id            String            @id @default(uuid())
  name          String            @unique
  description   String?

  users         User[]
  permissions   RolePermission[]

  createdAt     DateTime          @default(now())
}

model Permission {
  id            String            @id @default(uuid())
  name          String            @unique
  description   String?

  roles         RolePermission[]

  createdAt     DateTime          @default(now())
}

model RolePermission {
  id            String            @id @default(uuid())

  roleId        String
  permissionId  String

  role          Role              @relation(fields: [roleId], references: [id])
  permission    Permission        @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id            String            @id @default(uuid())

  tokenHash     String

  expiresAt     DateTime
  revokedAt     DateTime?

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime          @default(now())
}

model PasswordHistory {
  id            String            @id @default(uuid())

  passwordHash  String

  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime          @default(now())
}

model AuditLog {
  id            String            @id @default(uuid())

  action        AuditAction
  description   String?

  ipAddress     String?
  userAgent     String?

  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt     DateTime          @default(now())

  @@index([action])
  @@index([orderId])
}

model InventoryItem {
  id               String            @id @default(uuid())

  name             String
  sku              String            @unique
  description      String?

  unitPrice        Decimal           @db.Decimal(12, 2)
  costPrice        Decimal?          @db.Decimal(12, 2)

  quantityInStock  Int               @default(0)
  reorderLevel     Int               @default(0)

  status           InventoryStatus   @default(ACTIVE)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([sku])
  @@index([status])
}

model Category {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  image         String?
  displayOrder  Int       @default(0)
  isActive      Boolean   @default(true)

  products      Product[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([displayOrder])
  @@index([isActive])
}

model Product {
  id            String          @id @default(uuid())

  name          String
  sku           String?         @unique
  description   String?
  servings      String?
  contents      String[]        @default([])

  price         Decimal         @db.Decimal(12, 2)

  status        ProductStatus   @default(ACTIVE)
  isAvailable   Boolean         @default(true)
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)

  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images        String[]        @default([])

  orderItems    OrderItem[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([name])
  @@index([status])
  @@index([isAvailable])
  @@index([categoryId])
  @@index([featured])
  @@index([sortOrder])
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique

  customerName       String
  customerPhone      String
  customerEmail      String?

  channel            OrderChannel
  orderType          OrderType

  tableNumber        String?
  deliveryAddress    String?
  notes              String?

  subtotal           Decimal              @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal              @db.Decimal(12, 2)

  paymentStatus      PaymentStatus        @default(PENDING_CONFIRMATION)
  paymentClaimedAt   DateTime?
  kitchenStatus      KitchenStatus        @default(NOT_STARTED)
  fulfillmentStatus  FulfillmentStatus    @default(PENDING)

  createdByUserId    String?
  createdBy          User?                @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  whatsappSession    WhatsappSession?
  auditLogs          AuditLog[]
  notifications      Notification[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([orderNumber])
  @@index([customerPhone])
  @@index([channel])
  @@index([orderType])
  @@index([paymentStatus])
  @@index([kitchenStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_CONFIRMED
  ORDER_REJECTED
  ORDER_IN_PREPARATION
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_COMPLETED
  NEW_ORDER_PLACED
  UNPAID_ORDER_AWAITING_ACTION
  ORDER_CANCELLED
  ORDER_STUCK_PENDING
  ORDER_READY_NOT_PICKED_UP
  PAYMENT_INSTRUCTIONS_SENT
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_AWAITING_VERIFICATION
  REFUND_PROCESSED
  CUSTOM_UPDATE
  PRODUCT_LOW_STOCK
  PRODUCT_OUT_OF_STOCK
  DAILY_SALES_SUMMARY
  WEEKLY_PERFORMANCE_SUMMARY
  NEW_CUSTOMER_MILESTONE
  NOTIFICATION_DELIVERY_FAILURE
}

enum NotificationCategory {
  ORDER
  PAYMENT
  INVENTORY
  SYSTEM
}

enum NotificationAudience {
  ADMIN
  CUSTOMER
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id             String                      @id @default(uuid())

  type           NotificationType
  category       NotificationCategory
  audience       NotificationAudience
  channel        NotificationChannel
  status         NotificationDeliveryStatus  @default(SENT)

  title          String
  message        String

  recipientEmail String?
  recipientPhone String?

  isRead         Boolean                     @default(false)

  orderId        String?
  order          Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  errorMessage   String?

  createdAt      DateTime                    @default(now())

  @@index([audience])
  @@index([isRead])
  @@index([type])
  @@index([orderId])
  @@index([createdAt])
}

model Customer {
  id            String    @id @default(uuid())

  phone         String    @unique
  displayName   String?
  email         String?

  notes         String?
  tags          String[]  @default([])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone])
}

model OrderItem {
  id               String          @id @default(uuid())

  orderId          String
  productId        String

  quantity         Int
  unitPrice        Decimal         @db.Decimal(12, 2)
  lineTotal        Decimal         @db.Decimal(12, 2)

  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])

  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}
enum WhatsappSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  EXPIRED
}

enum WhatsappConversationStep {
  START
  BROWSING_MENU
  COLLECTING_ITEMS
  COLLECTING_ORDER_TYPE
  COLLECTING_NAME
  COLLECTING_PHONE
  COLLECTING_ADDRESS
  REVIEWING_ORDER
  AWAITING_CONFIRMATION
  ORDER_CREATED
}

model WhatsappSession {
  id                String                     @id @default(uuid())

  customerPhone     String                     @unique
  customerName      String?
  customerEmail     String?

  currentStep       WhatsappConversationStep   @default(START)
  status            WhatsappSessionStatus      @default(ACTIVE)

  orderType         OrderType?
  cartJson          Json?
  deliveryAddress   String?
  tableNumber       String?
  notes             String?

  lastMessageAt     DateTime?
  expiresAt         DateTime?

  orderId           String?                    @unique
  order             Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
  @@index([currentStep])
}
enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
  COMPLETED
}

enum RsvpAttendanceStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model Event {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  description     String?
  bodyText        String?
  eventDate       DateTime?
  location        String?
  capacity        Int?
  rsvpOpen        Boolean     @default(true)
  status          EventStatus @default(DRAFT)
  interestOptions String[]    @default([])
  dismissCount    Int         @default(0)

  rsvps           EventRsvp[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([slug])
  @@index([status])
}

model EventRsvp {
  id               String                @id @default(uuid())

  eventId          String
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name             String
  email            String?
  phone            String?
  numberAttending  Int                   @default(1)
  dietaryNote      String?
  hearAboutUs      String?
  interests        String[]              @default([])

  attendanceStatus RsvpAttendanceStatus  @default(PENDING)
  feedback         String?
  feedbackRating   Int?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([eventId])
  @@index([attendanceStatus])
}
