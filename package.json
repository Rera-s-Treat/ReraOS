{
  "name": "ReraOS",
  "private": true,
  "scripts": {
    "build": "pnpm --dir apps/api run build && pnpm --dir apps/admin-web run build",
    "prisma:seed": "tsx prisma/seed.ts",
    "dev": "node scripts/dev.mjs",
    "env:staging": "node scripts/use-env.mjs staging",
    "env:development": "node scripts/use-env.mjs development",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/passport": "^11.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}